{
  "name": "gigwork",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/serve.mjs --open",
    "dev": "bun ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "bun ./node_modules/vite/bin/vite.js build",
    "preview": "bun ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node --test src/domain.test.js src/live.test.js",
    "push:origin": "git push origin main",
    "push:public": "python3 scripts/sync-public.py",
    "push:all": "bun run push:origin && bun run push:public"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "2.56.0",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  }
}
