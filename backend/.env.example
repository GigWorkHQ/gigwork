# GigWork API configuration. Every value is validated at startup by src/config.ts.
# Copy to .env for local work. In production, set these as host secrets; never commit a real .env.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://gigwork:gigwork@localhost:5432/gigwork

# Chain: 4663 = Robinhood Chain mainnet, 46630 = testnet. RH_RPC_URL is private (it may carry a provider key).
RH_CHAIN_ID=46630
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Public RPC handed to browsers for "add network". Never the private one above.
PUBLIC_RPC_URL=
USDG_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
USDG_DECIMALS=6
RH_CONFIRMATIONS=2

# Sign-in (SIWE). AUTH_DOMAIN/AUTH_URI are the fallback site; allowed CORS origins are also accepted.
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Secrets: at least 32 random characters each, and all different. Generate with: openssl rand -hex 32
AUTH_TOKEN_PEPPER=
# Encrypts every escrow private key. Losing it strands escrowed funds; leaking it (with the DB) exposes them.
DATA_ENCRYPTION_KEY=
CRON_SECRET=
# Pays gas for escrow payouts. Keep its balance small and watched (see GAS_ALERT_*).
GAS_WALLET_PRIVATE_KEY=

# Comma-separated wallets allowed to use team routes (dispute rulings, reviewers, bonus approval, payout retries).
TEAM_WALLET_ADDRESSES=
# Number of proxies in front of the API (Render = 1). Used for client IPs in rate limiting.
TRUST_PROXY=1

# Review and dispute windows
JOB_REVIEW_HOURS=72
REVIEW_DRAW_DELAY_MINUTES=60
REVIEW_DEADLINE_HOURS=72
DISPUTE_WINDOW_HOURS=72

# Referrals: bonuses need team approval. Work counts only from distinct clients not linked to either wallet.
REFERRAL_BONUS_USDG=3
REFERRAL_MAX_INVITES=5
REFERRAL_MIN_APPROVED=10
REFERRAL_MIN_DAYS=7
REFERRAL_MIN_ITEM_USDG=1
REFERRAL_MIN_CLIENTS=3
# A client counts only once it has been on GigWork this long and has paid this many other, unlinked workers.
REFERRAL_CLIENT_MIN_AGE_DAYS=30
REFERRAL_CLIENT_MIN_OTHER_WORKERS=2

# Abuse limits
MIN_AMOUNT_USDG=0.1
DAILY_CREATE_LIMIT=100
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_RECOVERY_PER_MINUTE=6

# Monitoring: the keeper posts here (Slack/Discord-style JSON) at most hourly while the gas wallet is low or payouts failed.
GAS_ALERT_WEBHOOK_URL=
GAS_ALERT_MIN_ETH=0.0005

# Optional stock-token payout choices: SYMBOL:0xaddress, comma-separated. Empty = USDG only.
STOCK_TOKENS=
STOCK_EXCLUDED_COUNTRIES=US,GB,CA,CH
